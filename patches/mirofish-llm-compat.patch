 from __future__ import annotations
 
-from typing import Any, Dict, List, Optional
+import logging
+import re
+from typing import Any, Dict, List, Optional, Set
+
+logger = logging.getLogger(__name__)
+
+_UNSUPPORTED_CODES = {
+    "unsupported_parameter",
+    "unsupported_value",
+    "unknown_parameter",
+    "invalid_parameter",
+}
+
+# Parameters this layer can adapt after an explicit provider rejection.
+_ADAPTABLE_PARAMS = ("temperature", "max_tokens")
+
+# Per-model adaptations learned from explicit provider rejections, so a model
+# that refuses e.g. a custom temperature costs one rejected request, not one
+# per call. Keys are lower-cased model names.
+_LEARNED: Dict[str, Set[str]] = {}
+
+# Error codes / request parameters whose provider message is a short,
+# parameter-level description that does not echo user content.
+_MESSAGE_SAFE_CODES = _UNSUPPORTED_CODES | {
+    "context_length_exceeded",
+    "model_not_found",
+    "invalid_model",
+    "rate_limit_exceeded",
+    "insufficient_quota",
+}
+_MESSAGE_SAFE_PARAMS = {
+    "temperature", "top_p", "max_tokens", "max_completion_tokens",
+    "response_format", "reasoning_effort", "reasoning", "model",
+    "presence_penalty", "frequency_penalty", "n", "stop", "seed",
+}
+
+
+def _error_details(error: Exception) -> Dict[str, str]:
+    """Return the provider's structured error fields (never the request)."""
+    body = getattr(error, "body", None)
+    details = body.get("error", body) if isinstance(body, dict) else {}
+    if not isinstance(details, dict):
+        details = {}
+    return {
+        "code": str(details.get("code") or "").strip().lower(),
+        "param": str(details.get("param") or "").strip().lower(),
+        "type": str(details.get("type") or "").strip().lower(),
+        "message": str(details.get("message") or ""),
+    }
+
+
+def _rejected_param(error: Exception) -> Optional[str]:
+    """Name the adaptable parameter a provider explicitly rejected, if any."""
+    if getattr(error, "status_code", None) not in {400, 422}:
+        return None
+    details = _error_details(error)
+    param = details["param"]
+    if param in _ADAPTABLE_PARAMS and (
+        details["code"] in _UNSUPPORTED_CODES or not details["code"]
+        or details["type"] == "invalid_request_error"
+    ):
+        return param
+    return None
+
+
+def describe_provider_error(error: Exception) -> str:
+    """
+    Short, log-safe description of a provider error.
+
+    Always includes the structured ``code``/``param``/``type`` fields. The
+    provider message is included only for parameter-level or limit errors, and
+    is redacted and truncated. Request messages and documents are never logged.
+    """
+    details = _error_details(error)
+    parts = [
+        f"code={_scrub(details['code']) or 'unknown'}",
+        f"param={_scrub(details['param']) or 'none'}",
+        f"type={_scrub(details['type']) or 'unknown'}",
+    ]
+    if details["message"] and (
+        details["code"] in _MESSAGE_SAFE_CODES
+        or details["param"] in _MESSAGE_SAFE_PARAMS
+    ):
+        parts.append(f"message={_scrub(details['message'], 240)}")
+    return " ".join(parts)
+
+
+def _scrub(text: str, limit: int = 80) -> str:
+    cleaned = re.sub(r"\s+", " ", str(text)).strip()
+    cleaned = re.sub(r"\bsk-[A-Za-z0-9_-]{8,}|Bearer\s+\S+", "[redacted]", cleaned)
+    return cleaned[:limit]
 
 
