+                rejected, model,
+            )
+            _LEARNED.setdefault(model_key, set()).add(rejected)
+            _apply_adaptation(kwargs, rejected)
     return client.chat.completions.create(**kwargs)
 
 
+def _apply_adaptation(kwargs: Dict[str, Any], param: str) -> None:
+    if param == "temperature":
+        kwargs.pop("temperature", None)
+    elif param == "max_tokens" and "max_tokens" in kwargs:
+        kwargs["max_completion_tokens"] = kwargs.pop("max_tokens")
