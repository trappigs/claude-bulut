+def test_ontology_api_logs_structured_provider_detail_not_content(tmp_path, monkeypatch):
+    import logging
+
+    records = []
+
+    class ListHandler(logging.Handler):
+        def emit(self, record):
+            records.append(record.getMessage())
+
+    handler = ListHandler(level=logging.ERROR)
+    graph_api.logger.addHandler(handler)
+    monkeypatch.setattr(graph_api.logger, "disabled", False)
+
+    class ProviderError(RuntimeError):
+        status_code = 400
+        request_id = "req_safe"
+        body = {"error": {"message": "Unsupported value: 'temperature' does not support 0.3 with this model.",
+                          "type": "invalid_request_error", "param": "temperature",
+                          "code": "unsupported_value"}}
+
+    class FailingGenerator:
+        def generate(self, **kwargs):
+            raise ProviderError("provider failed")
+
+    monkeypatch.setattr(ProjectManager, "PROJECTS_DIR", str(tmp_path))
+    monkeypatch.setattr(graph_api, "OntologyGenerator", FailingGenerator)
+    app = create_app()
+    app.config.update(TESTING=True)
+    response = _post_ontology(app.test_client())
+
+    assert response.status_code == 502
+    assert "does not support 0.3" not in response.get_data(as_text=True)
+    graph_api.logger.removeHandler(handler)
+    logged = " ".join(records)
+    assert "param=temperature" in logged and "code=unsupported_value" in logged
+    assert "A short source document" not in logged
diff --git a/backend/tests/test_openai_chat_compat_adaptive.py b/backend/tests/test_openai_chat_compat_adaptive.py
new file mode 100644
index 0000000..2a7ff5e
--- /dev/null
+++ b/backend/tests/test_openai_chat_compat_adaptive.py
@@ -0,0 +1,110 @@
+import logging
+from types import SimpleNamespace
+
+import httpx
+import openai
+import pytest
+
+from app.utils import openai_chat_compat as compat
+from app.utils.openai_chat_compat import create_chat_completion, describe_provider_error
+
+
+def _bad_request(param, code="unsupported_value", message="rejected"):
+    request = httpx.Request("POST", "https://api.example.test/v1/chat/completions")
+    response = httpx.Response(400, request=request)
+    return openai.BadRequestError(
+        message,
+        response=response,
+        body={"error": {"message": message, "type": "invalid_request_error",
+                        "param": param, "code": code}},
+    )
+
+
+class Scripted:
+    def __init__(self, *outcomes):
+        self.outcomes = list(outcomes)
+        self.calls = []
+
+    def create(self, **kwargs):
+        self.calls.append(dict(kwargs))
+        outcome = self.outcomes.pop(0)
+        if isinstance(outcome, Exception):
+            raise outcome
+        return outcome
+
+
+def _client(scripted):
+    return SimpleNamespace(chat=SimpleNamespace(completions=scripted))
+
+
+@pytest.fixture(autouse=True)
+def _reset_learned():
+    compat._LEARNED.clear()
+    yield
+    compat._LEARNED.clear()
+
+
+def test_temperature_rejection_retries_once_without_temperature_and_is_remembered():
+    scripted = Scripted(_bad_request("temperature"), "ok1", "ok2")
+    client = _client(scripted)
+    kwargs = dict(model="future-model-x", messages=[{"role": "user", "content": "hi"}],
+                  temperature=0.3, max_tokens=None, response_format={"type": "json_object"})
+
+    assert create_chat_completion(client, **kwargs) == "ok1"
+    assert "temperature" in scripted.calls[0] and "temperature" not in scripted.calls[1]
+    assert scripted.calls[1]["response_format"] == {"type": "json_object"}
+
+    # Learned: the next call must not re-send temperature (no extra rejected request).
+    assert create_chat_completion(client, **kwargs) == "ok2"
+    assert len(scripted.calls) == 3 and "temperature" not in scripted.calls[2]
+
+
+def test_max_tokens_rejection_switches_to_max_completion_tokens():
+    scripted = Scripted(_bad_request("max_tokens", code="unsupported_parameter"), "ok")
+    create_chat_completion(_client(scripted), model="future-model-y",
+                           messages=[], temperature=None, max_tokens=321)
+    assert scripted.calls[0]["max_tokens"] == 321
+    assert scripted.calls[1] == {"model": "future-model-y", "messages": [],
+                                 "max_completion_tokens": 321}
+
+
+def test_both_rejections_adapt_in_sequence():
+    scripted = Scripted(_bad_request("max_tokens"), _bad_request("temperature"), "ok")
+    assert create_chat_completion(_client(scripted), model="m", messages=[],
+                                  temperature=0.5, max_tokens=10) == "ok"
+    assert scripted.calls[2] == {"model": "m", "messages": [], "max_completion_tokens": 10}
+
+
+def test_unrelated_400_is_propagated_without_retry():
+    error = _bad_request("messages", code="context_length_exceeded")
+    scripted = Scripted(error)
+    with pytest.raises(openai.BadRequestError):
+        create_chat_completion(_client(scripted), model="m", messages=[], temperature=0.3)
+    assert len(scripted.calls) == 1
+
+
+def test_response_format_rejection_is_not_handled_here():
+    scripted = Scripted(_bad_request("response_format"))
+    with pytest.raises(openai.BadRequestError):
+        create_chat_completion(_client(scripted), model="m", messages=[],
+                               response_format={"type": "json_object"})
+    assert len(scripted.calls) == 1
+
+
+def test_describe_provider_error_logs_parameter_message_but_not_unknown_messages():
+    safe = _bad_request("temperature", message="Unsupported value: 'temperature' does not support 0.3.")
+    assert "param=temperature" in describe_provider_error(safe)
+    assert "does not support 0.3" in describe_provider_error(safe)
+
+    unsafe = _bad_request("messages[0].content", code="invalid_value",
+                          message="SECRET-DOCUMENT-TEXT sk-abcdefghijklmnop")
+    detail = describe_provider_error(unsafe)
+    assert "SECRET-DOCUMENT-TEXT" not in detail and "sk-abcdefgh" not in detail
+    assert "code=invalid_value" in detail
+
+
+def test_describe_provider_error_redacts_api_keys_in_safe_messages():
+    error = _bad_request("model", code="model_not_found",
+                         message="Model missing for key sk-abcdefghijklmnopqrstuv")
+    detail = describe_provider_error(error)
+    assert "sk-abcdefgh" not in detail and "[redacted]" in detail
